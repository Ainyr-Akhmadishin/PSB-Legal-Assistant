# ------------------- LLM -------------------
#LLM_BASE_URL=https://api.klinch.cloud/v1          # ваш прокси‑сервер
#LLM_API_KEY=kl_live_AMvrnFQik3x_UD70dHeLewIC8FFVHmsy

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-14b:latest

EMBEDDER_BASE_URL=http://localhost:11434/v1
EMB_MODEL=bge-m3

RERANKER_ENABLED=0
# ------------------- Embeddings -------------------
EMB_MODEL=BAAI/bge-m3                            # имя модели (можно оставить)
# Если эмбеддинги идут через тот же URL, ничего больше не задаём.
# Если нужен отдельный сервис, раскомментируйте и укажите URL:
# EMBEDDER_BASE_URL=http://localhost:8001
# EMBEDDER_API_KEY=

# ------------------- Reranker -------------------
RERANKER_MODEL=Qwen3-Reranker-8B                  # имя модели‑реранкера
RERANKER_TOP_N=10
# Если реранкер развёрнут отдельно, раскомментируйте:
# RERANKER_BASE_URL=http://localhost:8002
# RERANKER_API_KEY=

# ------------------- Пороги отказа -------------------
MIN_TERM_OVERLAP=1
MIN_VECTOR_SCORE=0.20

# ------------------- Данные -------------------
DATA_DIR=data               # папка, где лежит kb.zip
CACHE_DIR=data/cache        # кеш векторов (можно оставить)

# ------------------- UI (для Streamlit) -------------------
API_URL=http://localhost:8000/answer   # если UI запускаете через Docker‑Compose, оставьте как есть